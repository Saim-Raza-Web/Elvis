# ==============================================================================
# REQUIRED PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# MongoDB Connection String (must point to production database / replica set)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/elvis_production?retryWrites=true&w=majority

# JWT Signing Secret (must be a secure, random string; strictly required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_high_entropy_jwt_secret_key_here

# AES-256-GCM Token Encryption Key for Connected Stores & OAuth Tokens
# Strictly required in production (32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Vercel / Automated Daily Cron Secret for /api/v1/expiry-alerts/cron
# Strictly required in production (passed as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_production_cron_secret_token_here

# Canonical Frontend Application URL for OAuth redirects & notifications
# Strictly required in production (no localhost fallback permitted)
CLIENT_URL=https://your-elvis-domain.vercel.app

# ==============================================================================
# OPTIONAL TRANSACTIONAL EMAIL CONFIGURATION (SMTP)
# (Required only if email delivery for purchase orders / alerts is enabled)
# ==============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_or_api_key
SMTP_FROM="Elvis Logistics <noreply@elvis.es>"
SMTP_SECURE=false

# ==============================================================================
# SPANISH TAX COMPLIANCE (AEAT - VERIFACTU & SII) (OPTIONAL)
# ==============================================================================
VERIFACTU_ENVIRONMENT=test
VERIFACTU_CERTIFICATE_PATH=/path/to/aeat/cert.p12
VERIFACTU_CERTIFICATE_PASSWORD=your_cert_password
SII_ENVIRONMENT=test
SII_CERTIFICATE_PATH=/path/to/aeat/cert.p12
SII_CERTIFICATE_PASSWORD=your_cert_password

# ==============================================================================
# MARKETPLACE INTEGRATION CREDENTIALS (OPTIONAL)
# ==============================================================================

# 1. SHOPIFY (OAuth 2.0 Admin App)
# Create app at https://partners.shopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

# 2. AMAZON SELLING PARTNER (SP-API / Login with Amazon)
# Register app at https://sellercentral.amazon.com / Developer Console
AMAZON_APP_ID=amzn1.sp.solution.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# 3. TIKTOK SHOP (Partner Open Platform)
# Register app at https://partner.tiktokshop.com
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_AUTH_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_API_URL=https://open-api.tiktokglobalshop.com

# 4. TEMU (Open Platform / MMS)
# Token authorization via Temu MMS or Open Platform App
TEMU_APP_KEY=your_temu_mms_app_key
TEMU_APP_SECRET=your_temu_mms_app_secret
TEMU_API_URL=https://open.temu.com/api/v1

# 5. EBAY (OAuth 2.0 Authorization Code Grant)
# Register at https://developer.ebay.com
EBAY_APP_ID=your_ebay_app_id
EBAY_CERT_ID=your_ebay_cert_id
EBAY_RU_NAME=your_ebay_ru_name

# 6. ALIEXPRESS (Open Platform TOP/AOP)
# Register at https://open.aliexpress.com
ALIEXPRESS_APP_KEY=your_aliexpress_app_key
ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret
ALIEXPRESS_AUTH_URL=https://oauth.aliexpress.com/authorize
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/rest

# 7. MIRAVIA (EU Open Platform)
# Register at https://open.miravia.es
MIRAVIA_APP_KEY=your_miravia_app_key
MIRAVIA_APP_SECRET=your_miravia_app_secret
MIRAVIA_AUTH_URL=https://auth.miravia.es/oauth/authorize
MIRAVIA_API_URL=https://api.miravia.es/rest

# ==============================================================================
# DEVELOPMENT / TEST CONFIGURATION ONLY
# ==============================================================================
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
OAUTH_HMAC_SECRET=your_oauth_signing_hmac_secret_2026
