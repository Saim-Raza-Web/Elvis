{
  "crons": [
    {
      "path": "/api/v1/expiry-alerts/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/replenishment/cron",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
