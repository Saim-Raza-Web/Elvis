{
  "crons": [
    {
      "path": "/api/v1/expiry-alerts/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/abc-classification/recalculate",
      "schedule": "0 2 * * 0"
    }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
